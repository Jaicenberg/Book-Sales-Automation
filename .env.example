# ──────────────────────────────────────────────────────────
# Book Sales Automation — Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────

# --- Google Cloud (REQUIRED) ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_SERVICE_ACCOUNT_KEY_PATH=./service-account.json
GMAIL_USER_EMAIL=ash@nickgray.net

# --- Pub/Sub (optional, defaults shown) ---
# PUBSUB_TOPIC=gmail-book-orders
# PUBSUB_SUBSCRIPTION=gmail-book-orders-sub

# --- Gmail label (optional, default: "book sales") ---
# GMAIL_LABEL_NAME=book sales

# --- Claude API (REQUIRED) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Amazon KDP (REQUIRED) ---
KDP_EMAIL=your-kdp-email@example.com
KDP_PASSWORD=your-kdp-password
KDP_TOTP_SECRET=your-totp-base32-secret

# --- Google Sheets (optional, defaults to Nick's sheet) ---
# GOOGLE_SHEET_ID=1jJ2jqHOwPUGuO1nQGL32SPj_jROdyeLSc77nqFIL9XU

# --- Nick & Ash (optional, defaults shown) ---
# NICK_EMAIL=nick@nickgray.net
# ASH_SENDER_NAME=Ash Smith
# KDP_GIFT_MESSAGE=Congrats! Here is your copy of The 2-Hour Cocktail Party...

# --- Dashboard (DASHBOARD_PASSWORD is required) ---
# DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=choose-a-strong-password
# DASHBOARD_PORT=5000

# --- Book Catalog (optional, defaults to The 2-Hour Cocktail Party) ---
# BOOK_CATALOG=[{"title": "The 2-Hour Cocktail Party", "kdp_id": ""}]

# --- Automation (optional) ---
DRY_RUN=true
# LOG_LEVEL=INFO
# SCREENSHOTS_DIR=./screenshots
# STATE_FILE=./state.json
# KDP_BROWSER_PROFILE_DIR=./browser_data
